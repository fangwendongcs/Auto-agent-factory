{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/recovery-policy.schema.json",
  "title": "Recovery Policy",
  "description": "Local-first recovery decision for failed, timed-out, or review-gated agent runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "run_id",
    "task_id",
    "error_class",
    "decision",
    "next_action",
    "max_retries",
    "retry_count",
    "timeout_minutes",
    "stop_conditions",
    "reason",
    "safety"
  ],
  "properties": {
    "policy_version": {
      "type": "string",
      "enum": [
        "v0.17-local-recovery-policy"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^gd_[A-Za-z0-9_-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_[A-Za-z0-9_-]+$"
    },
    "error_class": {
      "type": "string",
      "enum": [
        "input_error",
        "provider_error",
        "provider_timeout",
        "provider_aborted",
        "provider_output_truncated",
        "provider_invalid_json",
        "provider_response_missing",
        "malformed_evidence",
        "empty_response",
        "workflow_config_error",
        "timeout",
        "approval_blocked",
        "forbidden_action",
        "unknown"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "retry",
        "stop",
        "needs_review"
      ]
    },
    "next_action": {
      "type": "string",
      "enum": [
        "retry_provider_readonly",
        "manual_review",
        "stop_run"
      ]
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "timeout_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "write_actions_enabled",
        "requires_human_review",
        "secrets_included"
      ],
      "properties": {
        "read_only": {
          "type": "boolean"
        },
        "write_actions_enabled": {
          "type": "boolean"
        },
        "requires_human_review": {
          "type": "boolean"
        },
        "secrets_included": {
          "type": "boolean"
        }
      }
    }
  }
}
